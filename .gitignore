# Build output
/bin/
/dist/
/build/
/pinky
*.test
*.out
.mygo/

# OS
.DS_Store
._*
Thumbs.db
desktop.ini

# Captures from real devices must never be committed
/captures/
*.mp4
*.h264
*.h265
*.hevc

# Android
android/companion/.gradle/
android/companion/.kotlin/
android/companion/**/build/
android/companion/local.properties
*.apk
*.aab

# Local tools, editors and worktrees
/tmp/
/.worktrees/
/.claude/
/.cursor/
.idea/
.vscode/
*.swp
*~

# Local secrets and logs
.env
.env.*
!.env.example
*.log

# Third-party checkouts kept next to the code, not part of it
# (appium/WebDriverAgent, cloned by hand for older iPhones)
/WebDriverAgent/

# The web front end's dependencies and build (make web); dist keeps a
# placeholder so the Go embed compiles without a build.
node_modules/
*.tsbuildinfo
/ui/frontend/.vite/
/ui/frontend/coverage/
/ui/frontend/playwright-report/
/ui/frontend/test-results/
/ui/frontend/wailsjs/
npm-debug.log*
/ui/frontend/dist/*
!/ui/frontend/dist/.gitkeep
/cmd/pinky/build/

# The empty front-end skeleton from the first plan (the app lives in ui/frontend)
/frontend/
